PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# Simulated seconds per real second (1 = real time, 10 = demo fast-forward)
SIM_SPEED=1
SIM_SCENARIO=normal
SIM_SEED=7

# Optional: lets the Copilot ask Claude. Leave empty to use the built-in assistant.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-sonnet-5-5

# Where users and the audit log are saved. Default: SQLite file apps/api/data/greenwave.db
# DB_PATH=
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB=memory
